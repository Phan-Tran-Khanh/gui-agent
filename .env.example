# LLM API key (required)
API_KEY=

# Model identifier
MODEL=gemini/gemini-3.1-flash-lite-preview

# LLM API request timeout in seconds
REQUEST_TIMEOUT=60

# Base URL of the OmniParser service
PARSE_API_BASE_URL=http://127.0.0.1:8000

# Request timeout in seconds
PARSE_API_TIMEOUT_SEC=10

# Number of retries on failure
PARSE_API_RETRY_COUNT=1

# Retry back-off in milliseconds
PARSE_API_RETRY_BACKOFF_MS=250

# Set to false when using ngrok or self-signed TLS certificates
PARSE_API_VERIFY_SSL=true

# Set to true to return synthetic data for all external connections
# (OmniParser, ADB device, LLM). No real device or API keys required.
MOCK_MODE=false

# Enable context-aware image masking (LessIsMore) before sending screenshots
# to the MLLM. Reduces visual noise and focuses the model on the relevant region.
VISION_MASKING_ENABLED=false
